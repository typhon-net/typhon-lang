"""typhon test: fixtures, yield fixtures, parametrize, raises, approx, skip, a test class, and one failing test."""

import pytest


def add(a, b):
    return a + b


@pytest.fixture
def numbers():
    return [1, 2, 3]


@pytest.fixture
def resource():
    print("setup")
    yield {"open": True}
    print("teardown")


def test_add():
    assert add(2, 3) == 5


def test_uses_fixture(numbers):
    assert sum(numbers) == 6


def test_yield_fixture(resource):
    assert resource["open"]


@pytest.mark.parametrize("a, b, expected", [(1, 2, 3), (2, 2, 4), (5, -1, 4)])
def test_param(a, b, expected):
    assert add(a, b) == expected


def test_raises():
    with pytest.raises(ZeroDivisionError):
        1 // 0
    with pytest.raises(ValueError, match="invalid literal"):
        int("x")


def test_approx():
    assert 0.1 + 0.2 == pytest.approx(0.3)


def test_fails():
    print("about to fail")
    assert add(2, 2) == 5


@pytest.mark.skip(reason="not ready")
def test_skipped():
    assert False


class TestGroup:
    def test_one(self):
        assert "a" in "abc"

    def test_two(self, numbers):
        assert len(numbers) == 3
