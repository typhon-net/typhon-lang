class ParseDefect(ValueError):
    def __init__(self, line=None):
        if line is not None:
            super().__init__(line)
        self.line = line

class HeaderDefect(ParseDefect):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)

class InvalidHeaderDefect(HeaderDefect):
    pass

first = InvalidHeaderDefect("unexpected delimiter")
second = InvalidHeaderDefect(line="incomplete header")
print(str(first), first.line, first.args)
print(str(second), second.line, second.args)
print(InvalidHeaderDefect().args)
