import os
import sys
import tempfile

if os.name == "posix":
    from posix import *
else:
    from nt import *

with tempfile.TemporaryDirectory() as location:
    path = os.path.join(location, "sample.txt")
    descriptor = open(path, os.O_CREAT | os.O_WRONLY)
    print(isinstance(descriptor, int))
    close(descriptor)
    print(os.path.isfile(path))
print(sys.platform != "")
