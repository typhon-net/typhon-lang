events = []

class Record:
    def __set_name__(self, owner, name):
        events.append((owner.__name__, name))
        if name == "first":
            delattr(owner, "second")

class Meta(type):
    pass

class Base:
    def __init_subclass__(cls):
        events.append((cls.__name__, "init"))

class Declared(Base, metaclass=Meta):
    first = Record()
    second = Record()

print(events)
print(hasattr(Declared, "second"))

created = type("Created", (Base,), {"first": Record(), "second": Record()})
print(events)
print(hasattr(created, "second"))
