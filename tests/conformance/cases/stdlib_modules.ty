"""Conformance: itertools, collections, functools, operator, string, fractions, pathlib, doctest."""

import doctest
import operator
import string
from collections import Counter, OrderedDict, defaultdict, deque
from fractions import Fraction
from functools import cache, cmp_to_key, lru_cache, reduce
from itertools import (accumulate, chain, combinations, combinations_with_replacement, count, cycle, groupby, islice, pairwise,
                       permutations, product, takewhile)
from pathlib import Path


@lru_cache(maxsize=None)
def fib(n: int) -> int:
    return n if n < 2 else fib(n - 1) + fib(n - 2)


@cache
def paths(rows: int, cols: int) -> int:
    if rows == 0 or cols == 0:
        return 1
    return paths(rows - 1, cols) + paths(rows, cols - 1)


def by_length_then_alpha(a: str, b: str) -> int:
    if len(a) != len(b):
        return len(a) - len(b)
    return -1 if a < b else (1 if a > b else 0)


# itertools
print(list(permutations([1, 2, 3], 2)))
print(["".join(p) for p in permutations("abc")][:4], len(list(combinations(range(6), 3))))
print(list(product([1, 2], ["a", "b"])), len(list(product(range(3), repeat=3))))
print(list(combinations_with_replacement("ab", 2)), list(islice(count(10, 5), 4)), list(takewhile(lambda x: x < 20, count(15))))
print(list(islice(cycle("xy"), 5)), list(accumulate([1, 2, 3, 4])), list(chain([1, 2], [3], [])), list(chain.from_iterable([[1], [2, 3]])))
print([(k, len(list(g))) for k, g in groupby("aaabccdd")], list(pairwise([1, 2, 4, 7])))

# collections
words = "the cat and the hat and the bat".split()
c = Counter(words)
print(c.most_common(2), c["the"], c["dog"], len(c), sorted(c.elements())[:3], c.total())
letters = Counter("mississippi")
print(letters.most_common(3), letters + Counter("sip"))
tally = Counter()
for w in words:
    tally[w[0]] += 1
print(tally)
groups = defaultdict(list)
for w in words:
    groups[len(w)].append(w)
print(dict(groups), sorted(groups))
totals = defaultdict(int)
for w in words:
    totals[w] += len(w)
print(totals["the"], totals["zebra"], len(totals))
q = deque([1, 2, 3])
q.append(4)
q.appendleft(0)
q.rotate(2)
print(q, q.popleft(), q.pop(), list(q), len(q), q[0], q[-1])
window = deque(maxlen=3)
for i in range(6):
    window.append(i)
print(window, sum(window))
od = OrderedDict()
od["b"] = 2
od["a"] = 1
od.move_to_end("b")
print(od, list(od.keys()))

# functools and operator
print(fib(80), paths(10, 10), reduce(operator.mul, range(1, 11)), reduce(lambda a, b: a + b, ["x", "y", "z"], "<"))
print(sorted(["ccc", "a", "bb", "ab"], key=cmp_to_key(by_length_then_alpha)))

# string, fractions, pathlib, doctest
print(string.ascii_lowercase[:5], string.digits, len(string.punctuation), "a b" in string.ascii_letters + " ")
half = Fraction(1, 2)
third = Fraction(1, 3)
print(half + third, half * third, half - third, half / third, Fraction(6, 8), half < third, Fraction(3, 1), repr(half))
print(sum([Fraction(1, n) for n in range(1, 5)]), Fraction(1, 3) == Fraction(2, 6), Fraction("0.75"))
p = Path("/data/reports/summary.txt")
# as_posix(): the same text on every platform (str() uses backslashes on Windows, in CPython too)
print(p.name, p.stem, p.suffix, p.parent.as_posix(), p.parent.name, (Path("/data") / "x.txt").as_posix())
doctest.testmod()


@cache
def size_history():
    return []


first_history = size_history()
print(size_history() is first_history, size_history.cache_info())
clear_history = size_history.cache_clear
clear_history()
print(size_history() is first_history, size_history.cache_info(), size_history.__wrapped__.__name__)


import functools
import operator
from operator import or_ as merge

def join(values):
    return functools.reduce(operator.or_, values)

print(join([4, 1, 2]))
print(join([False, True, False]), type(join([False, True, False])).__name__)
print(sorted(join([{2}, {1, 2}])))
print(repr(join([int, str, bytes])))
print(functools.reduce(merge, [], initial=5))
try:
    functools.reduce(merge, [])
except TypeError as error:
    print(str(error))
