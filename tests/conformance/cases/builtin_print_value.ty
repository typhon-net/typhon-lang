from typing import Any


def invoke(function, *args, **kwargs):
    return function(*args, **kwargs)


def dispatch(caller: Any):
    print(caller(print, "left", 2, "right", sep=":", end="!\n") is None)


dispatch(invoke)
saved = print
print(saved is print)
print(saved("saved") is None)
