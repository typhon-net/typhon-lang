import time


print(time.asctime(time.gmtime(0)))
print(time.asctime((2026, 11, 3, 4, 5, 6, 1, 307, -1)))
print(time.asctime((-5, 0, 0, 12, 30, 61, 8, 0, 9)))
print(len(time.asctime().split()) == 5)
for invalid in (
    None,
    [2026, 11, 3, 4, 5, 6, 1, 307, -1],
    (2026,),
    (2026, 13, 3, 4, 5, 6, 1, 307, -1),
    (2026, 11, 3, 4, 5, 62, 1, 307, -1),
    (2026, 11, 3, 4, 5, 6, -2, 307, -1),
    (2026, 11, 3, 4, 5, 6, 1, 367, -1),
    (2147483648, 11, 3, 4, 5, 6, 1, 307, -1),
):
    try:
        time.asctime(invalid)
    except (TypeError, ValueError, OverflowError) as error:
        print(type(error).__name__)
