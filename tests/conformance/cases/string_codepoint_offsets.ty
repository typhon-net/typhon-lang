def late_order(left: object, right: object) -> bool:
    return left > right


def through_object(text: object, key: object):
    return text[key]


text = "a😀𝄞b"
print(len(text), text[0], text[1], text[2], text[-1], text[-3], text[True])
print(through_object(text, 2), through_object(text, slice(-3, -1)))
print(text[1:3], text[-3:-1], text[::2], text[::-1], text[3:0:-2], repr(text[20:]))
try:
    print(text[4])
except IndexError:
    print("positive index out of bounds")
try:
    print(text[-5])
except IndexError:
    print("negative index out of bounds")

print(text.find("𝄞"), text.find("b", 2, 4), text.find("b", 2, 3))
print(text.find("b", -2, 4), text.find("", 4), text.find("", 5))
print(text.find("\ud83d"), text.find("\ude00"))
print("\ud83d😀\ud83d".find("\ud83d"), "\ud83d😀\ud83d".find("\ud83d", 1))
print(text.index("𝄞"), text.index("b", -2))
print(text.startswith(("𝄞", "😀"), 1, 2), text.endswith("𝄞", 1, 3))

print("😀" > "\ue000", "a😀" > "a\ue000", late_order("😀", "\ue000"))
print("😀" > "\ud83d", "😀" > "\ud83dZ", "😀" < "😃", "𝄞" < "𝄞a")
print(["😀"] > ["\ue000"])
