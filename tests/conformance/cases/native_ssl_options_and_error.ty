import _ssl

context = _ssl._SSLContext(_ssl.PROTOCOL_TLS_SERVER)
print(context.options & _ssl.OP_NO_COMPRESSION != 0)
print(context.options & _ssl.OP_NO_TLSv1_2 == 0)
context.options |= _ssl.OP_NO_TLSv1_2
print(context.options & _ssl.OP_NO_TLSv1_2 != 0)
error = _ssl.SSLError(42, 'handshake refused')
print(str(error), error.args, error.errno)
error.reason = 'example'
error.library = None
print(error.reason, error.library)
