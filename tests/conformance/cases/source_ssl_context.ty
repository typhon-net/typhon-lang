#:pylib-source ssl
import _ssl
import ssl

client = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
server = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
print(type(client) is ssl.SSLContext, int(client.protocol), client.check_hostname, int(client.verify_mode))
print(type(server) is ssl.SSLContext, int(server.protocol), server.check_hostname, int(server.verify_mode))
print(int(ssl.TLSVersion.SSLv3), int(ssl.TLSVersion.TLSv1_2))
print(ssl.SSLError is _ssl.SSLError, ssl.SSLCertVerificationError is _ssl.SSLCertVerificationError)
print(client._msg_callback is None)
client._msg_callback = None
print(client._msg_callback is None)

purpose = ssl.Purpose.SERVER_AUTH
print(isinstance(purpose, ssl._ASN1Object), purpose.name, tuple(purpose))
print(ssl.Purpose(purpose.value) is purpose, ssl.Purpose.CLIENT_AUTH.value.nid)
print(ssl._ASN1Object.fromnid(129) == ssl.Purpose.SERVER_AUTH.value)
