class Label:
    def __repr__(self) -> str:
        return 'from repr'

    def __str__(self) -> str:
        return 'from str'


render = getattr(object, '__str__')
format_label = getattr(object, '__format__')
print(render is object.__str__, format_label is object.__format__)
print(render(Label()), format_label(Label(), ''))
try:
    format_label(Label(), 'unsupported')
except TypeError:
    print('invalid format')
