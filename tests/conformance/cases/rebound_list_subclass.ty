

class TokenList(list):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)

    @property
    def value(self) -> str:
        return "".join(str(piece) for piece in self)


def convert(pieces: list[str]):
    parts = ["["]
    for piece in pieces:
        parts.append(piece)
    parts = TokenList(parts[1:])
    return parts.value


print(convert(["x", "3", "y"]))
