import ast
import builtins

examples = [
    ("(value := 2)", "eval", 7, 8),
    ("match value:\n    case 2: pass\n", "exec", 9, 10),
    ("def identity[T](value: T) -> T: return value", "exec", 11, 12),
    ('t"value={value}"', "eval", 13, 14),
]
for source, mode, old, new in examples:
    try:
        compile(source, "<sample>", mode, ast.PyCF_ONLY_AST, _feature_version=old)
    except SyntaxError as exc:
        print(exc.msg)
    tree = builtins.compile(source, "<sample>", mode, ast.PyCF_ONLY_AST, _feature_version=new)
    print(type(tree).__name__)
print(eval(compile("(value := 2)", "<sample>", "eval", _feature_version=7)))
try:
    compile("2", "<sample>", "eval", ast.PyCF_ONLY_AST, _feature_version=10**10)
except OverflowError:
    print("invalid feature version")
