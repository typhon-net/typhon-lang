from array import array
from collections import deque
from collections.abc import MutableSequence

class Buffer(MutableSequence):
    def __init__(self):
        self.data: list[int] = []

    def __len__(self):
        return len(self.data)

    def __getitem__(self, i):
        return self.data[i]

    def __setitem__(self, i, value):
        self.data[i] = value

    def __delitem__(self, i):
        del self.data[i]

    def insert(self, i, value):
        self.data.insert(i, value)

b = Buffer()
b.append(2)
b.extend([3, 5])
b.extend(b)
b.reverse()
print(list(b))
print(b.pop(), b.pop(0), list(b))
b.remove(3)
print(list(b), 5 in b)
b.clear()
print(list(b))
print(isinstance([1], MutableSequence), isinstance((1,), MutableSequence))
print(isinstance(bytearray(b'a'), MutableSequence), isinstance(deque([1]), MutableSequence),
      isinstance(array('i', [1]), MutableSequence))
