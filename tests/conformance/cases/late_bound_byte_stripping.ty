import base64
from typing import Any


def encode(source: Any):
    return base64.urlsafe_b64encode(source).rstrip(b"=").decode("ascii")


def trim(source: Any):
    print(source.strip(b"ab"), source.lstrip(b"ab"), source.rstrip(b"ab"))


def whitespace(source: Any):
    return source.strip()


print(encode(b"t"), encode(b"longer"))
trim(b"ab-aba")
trim(bytearray(b"ba-ba"))
print(whitespace("  case  "), whitespace(b"  case  "))
