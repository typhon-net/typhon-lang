from typing import Any


class Recorder:
    @staticmethod
    def record(value: str) -> str:
        print(value)
        return "ignored return value"


class InstanceRecorder:
    def record(self, value: str) -> None:
        print(value)


def record(receiver: Any) -> None:
    receiver.record("before")
    message, _ = ("binding", "preserved")
    receiver.record("after")
    print(message, _)


def message() -> int:
    print("expression")
    return 4


def evaluate() -> None:
    [message()]
    _ = 8
    [message()]
    print(_)


record(Recorder)
record(InstanceRecorder())
evaluate()
