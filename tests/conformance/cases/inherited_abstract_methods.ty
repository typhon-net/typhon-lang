from abc import ABC, ABCMeta, abstractmethod
import inspect

class Base(metaclass=ABCMeta):
    @abstractmethod
    def required(self) -> str:
        raise NotImplementedError()

    @abstractmethod
    def second(self) -> str:
        raise NotImplementedError()

class Intermediate(Base):
    def second(self) -> str:
        return "second"

class Further(Intermediate):
    pass

class Concrete(Further):
    def required(self) -> str:
        return "required"

print(inspect.isabstract(Base), inspect.isabstract(Intermediate), inspect.isabstract(Further))
print(inspect.isabstract(Concrete))
concrete = Concrete()
print(concrete.required(), concrete.second())


class PowerBase(ABC):
    @abstractmethod
    def power(self, exponent: int) -> int:
        pass

class WithModulus(PowerBase):
    @abstractmethod
    def power(self, exponent: int, modulus: int = 0) -> int:
        pass

class ConcretePower(WithModulus):
    def power(self, exponent: int, modulus: int = 0) -> int:
        value = 2 ** exponent
        return value % modulus if modulus else value

def base_power(instance: PowerBase) -> int:
    return instance.power(4)

def modular_power(instance: WithModulus) -> int:
    return instance.power(4, 3)

print(base_power(ConcretePower()), modular_power(ConcretePower()))
