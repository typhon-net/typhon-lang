import io


byte_types = (bytes, bytearray)


def parts(data):
    if isinstance(data, byte_types):
        data = io.BytesIO(data)
    while item := data.read(2):
        yield item


print(list(parts(b"start")))
print(list(parts(io.BytesIO(b"other"))))
