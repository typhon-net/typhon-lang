class Positional:
    def __new__(cls, value: int):
        item = object.__new__(cls)
        item.value = value
        return item


class Keyword:
    def __new__(cls, *, value: int):
        item = object.__new__(cls)
        item.value = value
        return item


def restore_positional(cls, *args):
    return cls.__new__(cls, *args)


def restore_keyword(cls, args, keywords):
    return cls.__new__(cls, *args, **keywords)


print(Positional(11).value, Keyword(value=13).value)
print(restore_positional(Positional, 17).value)
print(restore_keyword(Keyword, (), {'value': 19}).value)

def all_integer_arguments(*args):
    return all(type(item) is int for item in args)


print(all_integer_arguments(1, 2, -3))
