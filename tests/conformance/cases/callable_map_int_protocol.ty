class Codec:
    @classmethod
    def parse(cls, text: str) -> int:
        return int(text, 16)

    def __index__(self) -> int:
        return 13

class Priority(Codec):
    def __int__(self) -> int:
        return 41

class Invalid:
    def __int__(self) -> str:
        return "23"

decoder: object = getattr(Codec, "parse")
numbers: list[str] = ["ff", "2a"]
print(list(map(decoder, numbers)))
print(int(Codec()), int(Priority()))
try:
    print(int(Invalid()))
except TypeError as error:
    print(str(error))


from typing import Protocol

class TextOperation(Protocol):
    def __call__(self, value: str, /) -> str:
        ...

def operation(prefix: str) -> TextOperation:
    def combine(value: str) -> str:
        return prefix + value
    return combine

def emphasize() -> TextOperation:
    return lambda text: text.upper()

label = operation("prefix-")
print(label("value"), label.__name__)
print(emphasize()("value"))
