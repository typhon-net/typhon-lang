import platform
import sys

expected = {"win32": "Windows", "linux": "Linux", "darwin": "Darwin"}
print(platform.system() == expected[sys.platform])
print(isinstance(platform.machine(), str), bool(platform.machine()))
print(isinstance(platform.node(), str), bool(platform.node()))
