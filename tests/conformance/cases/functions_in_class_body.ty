import operator

class Table:
    def value(left, right: int = 2):
        return left + right

    selected = value(3)
    saved = value

class Factory:
    def pair(make, fallback, limit: int = 4):
        def inner(left, right):
            return make(left, right) if left < limit else fallback(left, right)
        return inner
    def combine(left, right):
        return left * right
    first = pair(combine, operator.add)
    second = pair(combine, operator.sub, 8)

print(Table.selected, Table.value(4), Table.saved(4, right=5), Table.saved is Table.value)
print(Factory.first(2, 3), Factory.first(5, 3), Factory.second(7, 3), Factory.second(9, 3))
print(Factory.first(left=5, right=3), Factory.second(*(9, 3)))

class Example:
    amount: int = 9

class Ledger:
    def __init__(self, amount: int):
        self.amount = amount

    def balance(entry, adjustment: int = 1) -> int:
        return entry.amount + adjustment

    example = balance(Example())

print(Ledger.example, Ledger(5).balance(2), Ledger.balance(Ledger(6)))
