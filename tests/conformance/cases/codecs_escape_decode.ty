import codecs


print(codecs.escape_decode(br"line\nnext\t\x41\101\0" + b"\\\n"))
print(codecs.escape_decode(bytearray(b"\\n")))
print(codecs.escape_decode(br"a\xG1z", "replace"))
print(codecs.escape_decode(br"a\x1Gz", "ignore"))
try:
    codecs.escape_decode(br"a\xz")
except ValueError as error:
    print(str(error))
