from typing import Any

def change(value: Any):
    try:
        value['added'] = 2
    except TypeError:
        print('item assignment fails')
    try:
        del value['kept']
    except TypeError:
        print('item deletion fails')
    print(value.copy() is value, list(value.items()))

frozen = frozendict({'kept': 1})
known = {frozen: 'cached'}
change(frozen)
print(known[frozendict({'kept': 1})])
