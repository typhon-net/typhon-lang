from typing import Any


def replace(target: Any, source: Any) -> None:
    target[1:4] = source


backing = bytearray(b"abcde")
with memoryview(backing) as view:
    replace(view.cast("B"), b"xyz")
print(bytes(backing))

numbers = [0, 1, 2, 3, 4]
replace(numbers, range(10, 13))
print(numbers)

entries = [(1, 2), (3, 4), (5, 6)]
replace(entries, [(7, 8)])
print(entries)
