class Subproperty(property):
    pass


def read(receiver):
    return "value"


empty = Subproperty()
print(empty.fget is None, empty.fset is None)
custom = Subproperty(read, doc="example")
print(custom.__doc__, custom.__get__(object(), object), custom.fset is None)
