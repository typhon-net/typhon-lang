from collections import deque
from typing import Any


class Token:
    def __init__(self):
        self.token = "first"

    def get_token(self):
        return self.token.upper()

    def set_token(self, value: str):
        self.token = value


word = Token()
print(getattr(word, "token"), word.get_token())
word.set_token("next")
print(word.token)


class Buffer:
    def __init__(self):
        self.items = deque(maxlen=2)

    def store(self, name: str):
        self.items.appendleft((name, 1))

    def read(self):
        return self.items.popleft()


buf = Buffer()
buf.store("one")
buf.store("two")
buf.store("three")
print(buf.read(), buf.read())

source = "a😀b?"
mapping = source.maketrans({"a": ord("A"), "😀": None, ord("b"): "two"})
print(mapping, source.translate(mapping))
print("a+b-c;".translate("".maketrans(dict.fromkeys("+-;"))))
print("b".translate(str.maketrans({"b": ord("c")})))


def without_punctuation(chars: Any) -> str:
    return "a+b-c;".translate("".maketrans(dict.fromkeys(chars)))


print(without_punctuation("+-;"))


def boolean_identity(value: Any, other: Any) -> tuple[bool, bool, bool]:
    return value is True, value is other, value is not other


print(boolean_identity(True, True), boolean_identity(1, True), boolean_identity(False, False))


@object.__new__
class Marker:
    def __init__(self):
        raise AssertionError("initialization was bypassed")

    def __repr__(self):
        return "named marker"

    def __reduce__(self):
        return self.__class__.__name__


print(repr(Marker), Marker.__reduce__(), type(Marker).__name__)
print(isinstance(Marker, type), Marker is Marker)
