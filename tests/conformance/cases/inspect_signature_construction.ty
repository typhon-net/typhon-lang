from inspect import Parameter, Signature

value = Parameter("value", Parameter.POSITIONAL_OR_KEYWORD)
adjusted = Parameter("offset", Parameter.KEYWORD_ONLY, default=None, annotation=int)
print(value.default is Parameter.empty, value.annotation is Parameter.empty)
print(adjusted.default is None, adjusted.annotation is int)
print(Signature([value, adjusted], return_annotation=None))
print(Signature())

original = Signature([value, adjusted], return_annotation=None)
selected = original.replace(parameters=iter([adjusted]), return_annotation=Signature.empty)
print(original, selected)
print(original.replace(parameters=None), original.replace(return_annotation=int))
print(original.replace() is not original, original.return_annotation is None)
