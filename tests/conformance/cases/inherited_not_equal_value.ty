class Code:
    def __init__(self, value):
        self.value = value

    def __eq__(self, other):
        if isinstance(other, Code):
            return self.value == other.value
        return NotImplemented


class Child(Code):
    pass


descriptor = Child.__ne__
print(descriptor(Child(1), Child(1)))
print(descriptor(Child(1), Child(2)))
print(descriptor(Child(1), None) is NotImplemented)
bound = Child(1).__ne__
print(bound(Code(1)), bound(Code(2)))
