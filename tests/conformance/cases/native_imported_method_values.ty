import os
from os import fsdecode as decode, fsencode


class Codec:
    def __init__(self):
        self.encode = fsencode
        self.decode = decode

codec = Codec()
encoded = codec.encode("pré")
print(encoded, codec.decode(encoded))
print(codec.encode is os.fsencode, decode is os.fsdecode)
