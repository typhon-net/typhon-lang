import ast

sample = """# type: ignore[header]
text = '# type: uninterpreted'
count = (
    40 + 2
) # type: int
def add(
    x, # type: int
    y # type: int
):
    # type: (int, int) -> int
    return x + y
for n in []: # type: str
    pass
with context as handle: # type: Handle
    pass
skip = 0 # type: ignore[assignment]
"""

flags = ast.PyCF_ONLY_AST | ast.PyCF_TYPE_COMMENTS
tree = compile(sample, "<example>", "exec", flags)
print(tree.body[0].type_comment, tree.body[1].type_comment)
print(tree.body[2].type_comment, [arg.type_comment for arg in tree.body[2].args.args])
print(tree.body[3].type_comment, tree.body[4].type_comment)
print([(node.lineno, node.tag) for node in tree.type_ignores])
plain = compile(sample, "<example>", "exec", ast.PyCF_ONLY_AST)
print(plain.body[1].type_comment, len(plain.type_ignores))
try:
    compile("x: int = 1 # type: int", "<example>", "exec", flags)
except SyntaxError as exc:
    print(exc.msg)
