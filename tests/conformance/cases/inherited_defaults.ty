"""Conformance: inherited constructors keeping the base __init__'s defaults, builtins mapped over late-bound items, a list
literal for an Any parameter."""

from typing import Any

class Queue:
    def __init__(self, maxsize=0, label="q"):
        self.maxsize = maxsize
        self.label = label


class LifoQueue(Queue):
    pass


print(LifoQueue().maxsize, LifoQueue(5).maxsize, LifoQueue(label="x").label)




def describe(items: Any) -> str:
    args = []
    args.extend(map(repr, items))
    return ", ".join(args)


def lengths(items: Any) -> list:
    return list(map(len, items))


print(describe(["a", 1]), lengths(["ab", [1, 2, 3]]), list(map(str, [1, 2])))


inherited_default_marker = object()

class DefaultSentinelBase:
    def __init__(self, value=inherited_default_marker, *, label=inherited_default_marker):
        self.value = value
        self.label = label

class DefaultSentinelChild(DefaultSentinelBase):
    pass

omitted = DefaultSentinelChild()
explicit = DefaultSentinelChild(None, label=None)
print(omitted.value is inherited_default_marker, omitted.label is inherited_default_marker)
print(explicit.value is None, explicit.label is None)
