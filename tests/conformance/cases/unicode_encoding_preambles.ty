import codecs
text = '\ufeffcafé𐍈'
for encoding in ('utf-8-sig', 'utf-16', 'utf-32', 'utf-16-le', 'utf-16-be'):
    empty = ''.encode(encoding)
    encoded = text.encode(encoding)
    print(encoding, empty.hex(), encoded.hex(), encoded.decode(encoding) == text)
print((codecs.BOM_UTF16_BE + b'\x00A').decode('utf-16'))
print((codecs.BOM_UTF32_BE + b'\x00\x00\x00A').decode('utf-32'))
print(b'\xef\xbb\xbfA'.decode('utf-8') == '\ufeffA')
