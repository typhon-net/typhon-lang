def format(value, spec):
    return "shadowed format"


def repr(value):
    return "shadowed repr"


def str(value):
    return "shadowed str"


label = "text"
width = 4
print(f"{7:0{width}d} {label!r} {label}")
print(format(1, "d"), repr(2), str(3))
