#:pylib-source ssl
from enum import IntEnum
import _ssl
import ssl


class Version(IntEnum):
    TLS_1_2 = 771


native = _ssl._SSLContext(_ssl.PROTOCOL_TLS_CLIENT)
descriptor = getattr(_ssl._SSLContext, 'minimum_version')
descriptor.__set__(native, Version.TLS_1_2)
setattr(native, 'maximum_version', Version.TLS_1_2)
print(native.minimum_version, native.maximum_version)

context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
context.minimum_version = ssl.TLSVersion.TLSv1_2
context.maximum_version = ssl.TLSVersion.TLSv1_2
print(context.minimum_version is ssl.TLSVersion.TLSv1_2, context.maximum_version is ssl.TLSVersion.TLSv1_2)
context.verify_flags |= ssl.VERIFY_X509_PARTIAL_CHAIN
print(bool(context.verify_flags & ssl.VERIFY_X509_PARTIAL_CHAIN))
