import math as helpers

class Calculates:
    def helpers(self) -> float:
        return helpers.sqrt(9.0)

    def circle(self) -> float:
        return round(helpers.pi, 2)

    def has_helpers(self) -> bool:
        return hasattr(helpers, "sqrt")

example = Calculates()
print(example.helpers(), example.circle(), example.has_helpers())
