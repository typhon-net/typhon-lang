"""Conformance: matrix products (shapes, broadcasting) and numpy.linalg (Typhon runs it on Typhon.NumPy).

Values are printed rounded and invariants are checked with allclose, so rounding differences in the last bits (and
the free sign of eigenvectors and singular vectors) do not matter.
"""
import numpy as np


def r6(x: float) -> float:
    return round(float(x), 6) + 0.0


def vec(v: np.ndarray) -> list[float]:
    out: list[float] = []
    for i in range(v.shape[0]):
        x: float = v[i]
        out.append(r6(x))
    return out


def mat(m: np.ndarray) -> list[list[float]]:
    rows: list[list[float]] = []
    for i in range(m.shape[0]):
        row: list[float] = []
        for j in range(m.shape[1]):
            x: float = m[i, j]
            row.append(r6(x))
        rows.append(row)
    return rows


a = np.array([[4.0, -2.0, 1.0], [3.0, 6.0, -4.0], [2.0, 1.0, 8.0]])
b = np.array([12.0, -25.0, 32.0])

# products
m = np.arange(12.0).reshape(3, 4)
print(a @ m)
print(np.arange(3.0) @ m, m @ np.arange(4.0))
s = np.arange(24.0).reshape(2, 3, 4)
print((s @ np.arange(8.0).reshape(4, 2)).shape, (s @ np.arange(8.0).reshape(4, 2)).sum())
t = np.arange(40.0).reshape(2, 1, 4, 5)
u = np.arange(30.0).reshape(3, 5, 2)
print((t @ u).shape, (t @ u).sum())
big = np.arange(130.0 * 70.0).reshape(130, 70) / 1000.0
w = np.ones((70, 129)) * 0.5
p = big @ w
print(p.shape, r6(p.sum()), r6(p[129, 128]))

# LU-based
x = np.linalg.solve(a, b)
print(vec(x))
print(np.allclose(a @ np.linalg.inv(a), np.eye(3)))
print(r6(np.linalg.det(a)))
sign, logdet = np.linalg.slogdet(a)
print(sign, r6(logdet))
print(r6(np.linalg.det(np.array([[1.0, 2.0], [2.0, 4.0]]))))
try:
    np.linalg.inv(np.array([[1.0, 2.0], [2.0, 4.0]]))
except np.linalg.LinAlgError as e:
    print("LinAlgError:", e)
print(np.allclose(np.linalg.matrix_power(a, 3), a @ a @ a))
print(r6(np.linalg.norm(a)))

# Cholesky and QR
spd = a @ a.T + np.eye(3)
l = np.linalg.cholesky(spd)
print(mat(l))
print(np.allclose(l @ l.T, spd))
q, rr = np.linalg.qr(a)
print(mat(rr))
print(np.allclose(q @ rr, a), np.allclose(q.T @ q, np.eye(3)))
q2, r2 = np.linalg.qr(m.T, mode="complete")
print(q2.shape, r2.shape, np.allclose(q2 @ r2, m.T))

# symmetric eigenproblem and SVD
vals, vecs = np.linalg.eigh(spd)
print(vec(vals))
print(np.allclose(spd @ vecs, vecs * vals))
print(vec(np.linalg.eigvalsh(spd)))
uu, sv, vh = np.linalg.svd(m)
print(uu.shape, sv.shape, vh.shape)
print(vec(sv[:2]))
print(np.allclose(uu[:, :3] * sv @ vh[:3], m))
uu2, sv2, vh2 = np.linalg.svd(m, full_matrices=False)
print(uu2.shape, vh2.shape)
print(np.linalg.matrix_rank(m), r6(np.linalg.cond(a)))
xs, res, rank, sing = np.linalg.lstsq(np.vstack([np.arange(5.0), np.ones(5)]).T, np.array([1.0, 2.9, 5.1, 7.0, 9.2]), rcond=None)
print(vec(xs), vec(res), rank)
pi = np.linalg.pinv(m)
print(pi.shape, np.allclose(m @ pi @ m, m))
