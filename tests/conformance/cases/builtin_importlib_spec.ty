import builtins
import sys
from importlib.machinery import BuiltinImporter
from importlib.util import find_spec, module_from_spec

for name in ("builtins", "sys", "sys.optional", "not_a_builtin"):
    spec = BuiltinImporter.find_spec(name)
    if spec is None:
        print(name, spec)
    else:
        print(name, spec.origin, spec.has_location,
              spec.loader is BuiltinImporter, spec.submodule_search_locations)
print(BuiltinImporter.get_code("sys"), BuiltinImporter.get_source("sys"),
      BuiltinImporter.is_package("sys"))
spec = find_spec("sys")
print(spec is sys.__spec__, sys.__loader__ is BuiltinImporter)
print(BuiltinImporter.create_module(spec) is sys, module_from_spec(spec) is sys)
print(BuiltinImporter in sys.meta_path, BuiltinImporter.create_module(find_spec("builtins")) is builtins)
try:
    BuiltinImporter.get_source("not_a_builtin")
except ImportError as exc:
    print(exc.name, exc)
