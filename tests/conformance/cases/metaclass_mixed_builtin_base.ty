class RecordType(type):
    def __new__(mcls, name, bases, namespace):
        print(name, [base.__name__ for base in bases])
        return super().__new__(mcls, name, bases, namespace)


class Marker(metaclass=RecordType):
    pass


class Count(int, Marker):
    pass


print(type(Count).__name__)
print(Count.__bases__ == (int, Marker), issubclass(Count, Marker))
