from typing import Any

class Table:
    def __init__(self, entries: Any):
        self.entries = entries

    def get_entries(self):
        return self.entries

    def kinds(self):
        entries = self.get_entries()
        if not entries:
            entries = [('empty', 0, 1, 0, 1)]
        yield entries[0][0]
        yield entries[-1][-1]
        entries[-1] = ('updated', 1, 2, 3, 4)
        yield entries[-1][0]

print(list(Table([('one', 1, 2, 3, 4), ('two', 5, 6, 7, 8)]).kinds()))
print(list(Table([]).kinds()))
