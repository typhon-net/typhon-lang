import dataclasses as dc

@dc.dataclass
class Point:
    x: int
    y: int = 2

point = Point(3)
print(point, dc.is_dataclass(point))
print(dc.asdict(point))
print([(field.name, field.default is dc.MISSING) for field in dc.fields(point)])
print(dc.replace(point, y=9))

record = dc.make_dataclass("Record", [("value", int)])
print(record(7))
