import socket

with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    listener.listen()
    address: tuple[str, int] = listener.getsockname()
    with socket.create_connection(address, timeout=2.0) as client:
        peer, _ = listener.accept()
        with peer:
            reader = peer.makefile("rb", 8)
            writer = client.makefile("wb")
            original = peer.fileno()
            print(reader.fileno() == original, reader.readable(), reader.writable(), reader.seekable())
            peer.close()
            print(peer.fileno() == original)
            print(writer.write(b"hello\r\nworld\n"))
            writer.flush()
            print(reader.readline(4), reader.readline(), reader.readline())
            reader.close()
            print(peer.fileno() == -1, reader.closed)
            writer.close()
    with socket.create_connection(address, timeout=2.0) as client:
        peer, _ = listener.accept()
        with peer:
            with client.makefile("w", encoding="utf-8", newline="\n") as text:
                print(text.write("café\n"), text.mode)
                text.flush()
                print(peer.recv(64))
            try:
                client.makefile("r+")
            except ValueError as err:
                print(str(err))
