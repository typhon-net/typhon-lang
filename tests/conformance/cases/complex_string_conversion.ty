from typing import Any


def show(convert: Any, text: str):
    result = convert(text)
    print(result.real, result.imag)


show(complex, "  (1e2-2_5j) ")
show(complex, "-J")
show(complex, "3.5")
show(complex, "２+٤j")
show(complex, "-Infinity+nanJ")
try:
    show(complex, "1_+2j")
except ValueError:
    print("invalid digit separator")
