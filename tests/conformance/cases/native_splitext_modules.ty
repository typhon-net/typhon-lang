import ntpath
import posixpath

for separator in [posixpath, ntpath]:
    splitext = getattr(separator, 'splitext')
    print(splitext(r'directory\.profile'))
    print(splitext(b'directory/.data.bin'))
    print(splitext('local/...profile'))
