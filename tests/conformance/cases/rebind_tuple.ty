from typing import Any

def copied(x: Any, transform: Any) -> Any:
    y = [transform(a) for a in x]
    for k, j in zip(x, y):
        if k is not j:
            y = tuple(y)
            break
    else:
        y = x
    return y

def replace(a: Any) -> Any:
    return a + 1

print(copied((1, 2), replace))
