import asyncio
from typing import Any, AsyncIterator


async def native() -> AsyncIterator[int]:
    yield 1
    yield 2
    yield 3


class Counter:
    def __init__(self):
        self.position = 0

    def __aiter__(self):
        return self

    async def __anext__(self):
        if self.position == 3:
            raise StopAsyncIteration()
        self.position += 1
        return (self.position, 10 * self.position)


class Indirect:
    def __aiter__(self):
        print("iterated indirect")
        return Counter()


async def drain(source: Any):
    async for item in source:
        print(item)


async def main():
    source = native()
    print(await anext(source))
    await drain(source)
    print(await anext(source, "ended"))
    async for position, value in Indirect():
        print(position, value)
    custom_source = Counter()
    print(await anext(custom_source))
    await drain(custom_source)


asyncio.run(main())
