from typing import Any


def collect(tag="default", *items, **kwargs):
    if items:
        items = (0,) + items
    return tag, items, kwargs


print(collect())
saved: Any = collect
print(saved())
print(saved("call", 1, 2, style="bold"))
print(saved(tag="named", style="plain"))


def typed(*items: int):
    return (1,) + items


print(typed(3, 4))
