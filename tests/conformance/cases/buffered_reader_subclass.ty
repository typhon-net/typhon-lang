import io

class Reader(io.BufferedReader):
    def __init__(self, content: bytes):
        raw = io.BytesIO(content)
        super().__init__(raw, buffer_size=2)

reading = Reader(b'abcdef')
print(reading.read(2), reading.tell(), reading.read())
reading.close()
