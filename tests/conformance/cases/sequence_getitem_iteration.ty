from typing import Any

class IndexOnly:
    def __getitem__(self, index: int):
        if index == 3:
            raise IndexError("end")
        return index * 2

class StopsEarly:
    def __getitem__(self, index: int):
        if index == 2:
            raise StopIteration()
        return index + 1

def through_any(value: Any):
    return list(value)

items = IndexOnly()
position = iter(items)
print(next(position), list(position))
print([item + 1 for item in items], through_any(StopsEarly()))
