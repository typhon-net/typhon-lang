for text, codec in (("caféß", "ascii"), ("a💡λb", "latin_1")):
    try:
        print(text.encode(codec))
    except UnicodeEncodeError as error:
        print(error.encoding, error.start, error.end, error.reason)
    print(text.encode(codec, "replace"))
try:
    print(b"a\xffb".decode("us-ascii"))
except UnicodeDecodeError as error:
    print(error.encoding, error.start, error.end, error.reason)
print(b"a\xffb".decode("latin-1"))
