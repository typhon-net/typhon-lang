import builtins
from typing import Any

space: dict[str, Any] = {"x": 4}
compiled = compile("x += 3\ny = x * 2\n", "example.py", "exec")
exec(compiled, space)
print(space["x"], space["y"])
print(eval("x + y", space))
exec(compile("x + 1", "<sample>", "single"), space)
print(builtins._)
exec("def times(value):\n    return value * x", space)
print(space["times"](3))
exec(compile("print('text')\n", "<sample>", "single"), space)
exec(compile("'display string'\n", "<sample>", "single"), space)
exec(compile("for i in range(2):\n    i\n", "<sample>", "single"), space)
exec(compile("None\n", "<sample>", "single"), space)
print(space["i"])
try:
    compile("return +", "<test>", "eval")
except SyntaxError:
    print("syntax error")
