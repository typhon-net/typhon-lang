import os
import py_compile
import tempfile

with tempfile.TemporaryDirectory() as folder:
    source = os.path.join(folder, 'sample.py')
    with open(source, 'wb') as file:
        file.write(b'answer = 42\n')
    for name, flag in [('TIMESTAMP', 0), ('CHECKED_HASH', 3), ('UNCHECKED_HASH', 1)]:
        output = os.path.join(folder, name + '.pyc')
        invalidation = py_compile.PycInvalidationMode[name]
        print(py_compile.compile(source, output, 'sample.py', True, 1, invalidation) == output)
        with open(output, 'rb') as file:
            header = file.read(16)
            data = file.read()
        print(len(header) == 16, header[2:4] == b'\r\n', header[4] == flag, bool(data))
    cachefile: str = py_compile.compile(source, dfile='sample.py', optimize=1)
    print(os.path.basename(cachefile).endswith('.opt-1.pyc'))
