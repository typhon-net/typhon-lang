import os
from pathlib import Path
from typing import Any

def ancestor(left: Any, right: Any) -> str | bytes:
    return os.path.commonpath([left, right])

print(ancestor(Path('first') / 'left', os.path.join('first', 'right')))
print(ancestor(b'first/left', b'first/right'))
