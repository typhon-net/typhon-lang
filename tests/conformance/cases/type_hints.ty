from typing import get_type_hints
from annotationlib import Format

class Parent:
    first: int

class Child(Parent):
    second: str

def sample(item: "Child", flag: bool) -> None:
    pass

def unresolved(value):
    pass


unresolved.__annotations__ = {"value": "Unknown", "return": "int"}

print([(name, value.__name__) for name, value in get_type_hints(sample).items()])
print([(name, value.__name__) for name, value in get_type_hints(Child).items()])
print([(name, repr(value)) for name, value in get_type_hints(unresolved, format=Format.FORWARDREF).items()])
