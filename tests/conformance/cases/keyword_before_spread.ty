def pair() -> tuple[int, int]:
    print("positional")
    return 1, 2


def named() -> int:
    print("keyword")
    return 3


class Writer:
    def save(self, a: int, b: int, obj: int) -> None:
        print(a, b, obj)


writer = Writer()
writer.save(obj=named(), *pair())
