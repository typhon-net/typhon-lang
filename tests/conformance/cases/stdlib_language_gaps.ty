import __future__
import _colorize
import io
import linecache
import os
import sys
import traceback
import warnings
from typing import Any


def rows(entries: list[Any]):
    for label, (failed, tried) in entries:
        print(label.upper(), failed, tried)


for label, value in {"first": 1, "second": 2}.items():
    label = label.upper()
    value = value * 3
    print(label, value)

rows([("demo", (1, 3)), ("all", (2, 4))])


def unpack(items: Any):
    left, right = items
    print(left, right)


def values():
    for i in range(8):
        print("read", i)
        yield i


try:
    unpack(values())
except ValueError:
    print("unpack failed")


class Record:
    def __init__(self, value: int):
        self.value = value

    def read(self):
        return self.value


class DerivedRecord(Record):
    def read(self):
        return Record.read(self) + 1


method = DerivedRecord(19).read
print(method())


class Parent:
    def __init__(self, label=None, count=2):
        self.label = label
        self.count = count


class InheritsInit(Parent):
    pass


class SpreadsInit(Parent):
    def __init__(self, *args, tag: str, **kwargs):
        super().__init__(*args, **kwargs)
        self.tag = tag


default_parent = InheritsInit()
print(default_parent.label, default_parent.count)
spread = SpreadsInit("value", tag="name", count=3)
print(spread.label, spread.count, spread.tag)


def show(*items: int, tag: str, end: str = "!"):
    print(tag, items, end)


show(tag="empty")
show(3, 5, tag="two", end="?")
show(1, *[7, 9], tag="spread")


def collect(*args, tag, **rest):
    print(tag, args, rest)


collect(tag="empty")
collect(1, 2, tag="full", extra=3)

saved_stdout = sys.stdout
saved_stdin = sys.stdin
capture = io.StringIO()
sink = io.StringIO()
try:
    sys.stdout = capture
    sys.stdin = io.StringIO("reply\n")
    print("one")
    print(1, 2, sep=":")
    print("done", end="!", flush=True)
    print("separate", file=sink)
    print(input("prompt> "))
    write = sys.stdout.write
    print(write("bound"), file=sink)
finally:
    sys.stdout = saved_stdout
    sys.stdin = saved_stdin
print(repr(capture.getvalue()), repr(sink.getvalue()))


def small_int_identity(value):
    zero, one = range(2)
    return value is one, value is zero, value is True


print(small_int_identity(int("1")), small_int_identity(True))

saved_colors = os.environ.get("PYTHON_COLORS")
try:
    os.environ["PYTHON_COLORS"] = "0"
    print(_colorize.can_colorize(), _colorize.get_colors().RED == "")
    os.environ["PYTHON_COLORS"] = "1"
    print(_colorize.can_colorize(), _colorize.get_colors().RED == _colorize.ANSIColors.RED)
    print(_colorize.decolor(_colorize.ANSIColors.RED + "text" + _colorize.ANSIColors.RESET))
finally:
    if saved_colors is None:
        del os.environ["PYTHON_COLORS"]
    else:
        os.environ["PYTHON_COLORS"] = saved_colors


def substituted_lines(filename, module_globals=None):
    return [filename + "\n", "second\n"]


saved_lines = linecache.getlines
try:
    linecache.getlines = substituted_lines
    print(repr(linecache.getline("dummy", 1)), repr(linecache.getline("dummy", 2)))
finally:
    linecache.getlines = saved_lines

with warnings.catch_warnings(record=True) as log:
    warnings._setoption("error:needle:UserWarning")
    try:
        warnings.warn("needle in a haystack")
    except UserWarning:
        print("filter promoted warning")

print(str(b"caf\xc3\xa9", "utf-8"))
print(str("é—😄".encode("ascii", "backslashreplace"), "ascii"))
print(str(bytearray(b"\xff"), "utf-8", "backslashreplace"))

data = {"a": None, "b": None}
data["b"] = 2
print(data)
print("annotations" in __future__.all_feature_names, __future__.annotations.compiler_flag)


def explode():
    raise ValueError("test")


try:
    explode()
except ValueError as e:
    frames = traceback.extract_tb(e.__traceback__)
    print(type(e.__traceback__).__name__, [f.name for f in frames])
    print(sys.exc_info()[2] is e.__traceback__)
