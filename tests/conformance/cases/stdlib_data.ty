"""Conformance: heapq, bisect, copy, json, re, io.StringIO, array, frozenset, sys.stdout, the order sets of ints print in."""

import array
import bisect
import collections
import copy
import heapq
import itertools
import json
import re
import sys
from io import StringIO

h = []
for x in [5, 1, 8, 3, 9, 2]:
    heapq.heappush(h, x)
print(h, heapq.heappop(h), h, heapq.nsmallest(2, [4, 1, 3]), heapq.nlargest(2, [4, 1, 3]))
data = [9, 4, 7, 1]
heapq.heapify(data)
print(data, heapq.heappushpop(data, 0), heapq.heapreplace(data, 10), data)
pq = [(3, "c"), (1, "a"), (2, "b")]
heapq.heapify(pq)
print(heapq.heappop(pq), pq)

a = [1, 3, 5, 7]
print(bisect.bisect_left(a, 5), bisect.bisect_right(a, 5), bisect.bisect(a, 4))
bisect.insort(a, 4)
print(a)

nested = [[1, 2], [3, 4]]
shallow = copy.copy(nested)
deep = copy.deepcopy(nested)
nested[0].append(99)
print(shallow, deep)

doc = {"name": "x", "vals": [1, 2.5, None, True], "nested": {"k": "é"}}
s = json.dumps(doc)
print(s)
print(json.dumps(doc, indent=2, sort_keys=True))
back = json.loads('{"a": [1, 2, {"b": null}], "c": 1.5e3, "d": "\\u00e9"}')
print(back, back["a"][2], json.dumps(back, separators=(",", ":")))

m = re.match(r"(?P<word>\w+) (\d+)", "hello 42 world")
if m:
    print(m.group(), m.group(1), m.group("word"), m.group(2), m.groups(), m.span(), m.start(2), m.groupdict())
print(re.findall(r"\d+", "a1b22c333"), re.findall(r"(\w)=(\d)", "a=1 b=2"))
print(re.sub(r"(\w+)@(\w+)", r"\2 at \1", "me@host you@there"), re.split(r"[,;]\s*", "a, b;c"), re.split(r"(-)", "1-2-3"))
print(re.sub(r"\d", lambda mm: str(int(mm.group()) * 2), "a1b2"), re.escape("a.b*c"), re.search(r"z", "abc"))
pat = re.compile(r"[aeiou]", re.IGNORECASE)
print(pat.findall("hEllO"), pat.sub("_", "Banana"), pat, len(pat.findall("xyz")))
buf = StringIO()
buf.write("line1\n")
print("line2", file=buf)
print(buf.getvalue(), end="")
print(frozenset([3, 1, 2]), {frozenset([1, 2]): "x"}[frozenset([2, 1])])


WORD = re.compile(r"(\w+)=(\d+)")


def parse(text):
    out = {}
    for key, val in WORD.findall(text):
        out[key.upper()] = int(val)
    return out


def dijkstra(graph, start):
    dist = {start: 0}
    pq = []
    heapq.heappush(pq, (0, start))
    while pq:
        d, node = heapq.heappop(pq)
        for nxt, w in graph[node]:
            nd = d + w
            if nd < dist.get(nxt, 10**9):
                dist[nxt] = nd
                heapq.heappush(pq, (nd, nxt))
    return dist


print(parse("a=1 bb=22"), [t.lower() for t in re.findall(r"[A-Z]\w*", "Hello World foo Bar")])
print(dijkstra({"a": [("b", 2), ("c", 5)], "b": [("c", 1)], "c": []}, "a"))
xs = array.array("d", [1, 2, 3])
xs.append(4.5)
print(xs, sum(xs), xs[1] * 2, len(xs))
print(type(xs).__name__, type(xs).__module__, type(collections.deque([1])).__module__)
print(list(itertools.islice((1, 2, 3), 2)))
print({3, 1, 2, 17, 9, 100, -1, 8}, set(range(20, 0, -3)), {10, 2, 33, 4})
sys.stdout.write("written to sys.stdout\n")
