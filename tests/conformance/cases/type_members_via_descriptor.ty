class Base:
    pass

class Derived(Base):
    label = "child"

mro = type.__dict__["__mro__"]
namespace = type.__dict__["__dict__"]
bases = type.__dict__["__bases__"]
print(mro.__get__(Derived) == Derived.__mro__, bases.__get__(Derived) == Derived.__bases__)
print(namespace.__get__(Derived)["label"], mro.__name__, mro.__objclass__ is type)
print(mro.__get__(None, type) is mro)
