from abc import ABC, abstractmethod

original = ['captured']

class Base(ABC):
    @abstractmethod
    def describe(self, value: str) -> str:
        ...

class Child(Base):
    def describe(self, text: str, suffix=original) -> str:
        return text + ' ' + suffix[0]

original = ['later']

def report(receiver: Base) -> str:
    return receiver.describe('default')

print(report(Child()))
print(Child().describe('override', ['argument']))
