class Parser:
    def __init__(self, recover):
        self.recover = recover

    def read(self, error):
        try:
            raise error
        except self.recover as caught:
            return str(caught)

print(Parser(ValueError).read(ValueError('caught')))
print(Parser((ValueError, TypeError)).read(TypeError('tuple')))
try:
    Parser(ValueError).read(OSError('escapes'))
except OSError as err:
    print(str(err))
