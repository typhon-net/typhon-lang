from typing import Any

def fallback(value: Any):
    if not value:
        return
    return value

def annotated(flag: bool) -> int:
    if not flag:
        return
    return 7

def explicit() -> None:
    return None

print(fallback("yes"), fallback(""))
print(annotated(True), annotated(False))
explicit()
print(list(filter(None, ["", "foo", "0", "", "bar"])))
print(list(filter(None, {"": 1, "kept": 2})))
