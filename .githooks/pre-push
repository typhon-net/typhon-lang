#!/usr/bin/env bash
# Typhon pre-push hook: CI's conformance step (dotnet test tests/Typhon.Conformance.Tests -c Release) before the commits
# leave this machine, with the CPython CI uses as the oracle. Skipped when the pushed commits change only docs.
# Skip once: git push --no-verify, or TYPHON_SKIP_HOOKS=1. Enable once per clone: git config core.hooksPath .githooks
set -uo pipefail
[ "${TYPHON_SKIP_HOOKS:-}" = "1" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
. .githooks/common.sh

zero=0000000000000000000000000000000000000000
changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # a deleted branch
    if [ "$remote_sha" = "$zero" ]; then base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    else base="$remote_sha"
    fi
    if [ -n "$base" ]; then changed="$changed $(git diff --name-only "$base" "$local_sha")"
    else changed="$changed src/"
    fi
done
if ! echo "$changed" | tr ' ' '\n' | grep -qE '\.(cs|ty|out|csproj|props|targets|slnx|py|yml)$|^src/|^tests/|^samples/'; then
    exit 0
fi

dotnet=$(typhon_dotnet) || exit 1
python=$(typhon_python)
export TYPHON_CPYTHON="$python"
echo "pre-push: building and running the conformance suite as CI does (TYPHON_SKIP_HOOKS=1 or --no-verify skips) ..."
if ! out=$("$dotnet" build Typhon.slnx -c Release -nologo -v q 2>&1); then
    echo "$out" | grep -E ' error |error\(s\)' | sort -u | head -30
    echo "pre-push: the build fails" >&2
    exit 1
fi
out=$("$dotnet" test tests/Typhon.Conformance.Tests -c Release --no-build -nologo 2>&1)
status=$?
echo "$out" | grep -E 'Passed!|Failed!' | tail -1
if [ $status -ne 0 ]; then
    echo "$out" | grep -E '^\s+Failed |line [0-9]+ [-+]' | head -40
    echo "pre-push: conformance tests fail; the push is stopped" >&2
    exit 1
fi
exit 0
