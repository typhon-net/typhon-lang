<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Typhon runtime (Python builtins + small stdlib) precompiled once, for `typhon run` / `typhon check` and the
    compile server: scripts compiled in memory reference this assembly instead of compiling the runtime source every
    time (it is most of the work of a warm compile). `typhon build`, Native AOT and the source generator keep embedding
    the same source as internal types, so built programs and libraries still need no extra assembly.
  -->
  <PropertyGroup>
    <TargetFramework>$(TyphonTargetFramework)</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Typhon.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Typhon.Compiler\Runtime\Builtins.cs" Link="Builtins.cs" />
    <Compile Include="..\Typhon.Compiler\Runtime\Stdlib.cs" Link="Stdlib.cs" />
    <Compile Include="..\Typhon.Compiler\Runtime\Modules.cs" Link="Modules.cs" />
    <Compile Include="..\Typhon.Compiler\Runtime\Json.cs" Link="Json.cs" />
    <Compile Include="..\Typhon.Compiler\Runtime\Regex.cs" Link="Regex.cs" />
    <Compile Include="..\Typhon.Compiler\Runtime\Bytes.cs" Link="Bytes.cs" />
    <Compile Include="..\Typhon.Compiler\Runtime\Random.cs" Link="Random.cs" />
  </ItemGroup>

</Project>
