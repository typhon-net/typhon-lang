"""
A to-do list in WPF, written in Typhon. This module is the entry point (what App.xaml and its generated Main are in a C#
WPF app): it creates the Application and runs it with the window.

    dotnet run --project samples/Desktop/Wpf                 (Windows)
    dotnet run --project samples/Desktop/Wpf -- --smoke      (scripted: clicks through the window, prints, exits)
"""
import sys
import time
from System import Environment, EventArgs, STAThread
from System.Threading import Thread
from System.Threading.Tasks import Task
from System.Windows import Application, RoutedEventArgs, WindowStartupLocation
from System.Windows.Controls import Button
from System.Windows.Controls.Primitives import ButtonBase
from todo_window import TodoWindow


@STAThread
def main(args: list[str]) -> None:
    # @STAThread puts [STAThread] on the Main that Typhon generates: WPF refuses to create windows on other threads
    app = Application()
    window = TodoWindow()
    if "--smoke" in args:
        SmokeTest(window)
    app.Run(window)


class SmokeTest:
    """--smoke: runs the real Dispatcher loop, drives the window as a user would, prints what it shows and closes it."""

    def __init__(self, window: TodoWindow) -> None:
        self.window = window
        self.running = Task.CompletedTask
        # a safety net: a window nobody can see must not outlive a run that got stuck
        watchdog = Thread(lambda: exit_if_stuck(60.0))
        watchdog.IsBackground = True
        watchdog.Start()
        # the window is shown and rendered, but off-screen and without a taskbar button
        window.ShowInTaskbar = False
        window.ShowActivated = False
        window.WindowStartupLocation = WindowStartupLocation.Manual
        window.Left = -32000
        window.Top = -32000
        window.ContentRendered += self.on_rendered

    def on_rendered(self, sender: object, e: EventArgs) -> None:
        self.running = self.run()

    async def run(self) -> None:
        window = self.window
        try:
            ui_thread = Thread.CurrentThread.ManagedThreadId
            print(f"WPF on .NET {Environment.Version}, UI thread: {Thread.CurrentThread.GetApartmentState()}")
            for title in ["Buy milk", "Write a Typhon sample"]:
                window.input.Text = title
                click(window.add_button)
            print("added two:", window.shown_items(), "-", window.status.Text)
            window.input.Text = "   "
            print("Add enabled for a blank title:", window.add_button.IsEnabled)
            window.item_box(0).IsChecked = True
            print("ticked the first:", window.shown_items(), "-", window.status.Text)
            click(window.remove_button)
            print("removed done:", window.shown_items(), "-", window.status.Text)
            click(window.load_button)
            print("loading:", window.status.Text, "- Load enabled:", window.load_button.IsEnabled)
            await window.loading
            print("loaded examples:", window.shown_items(), "-", window.status.Text)
            print("back on the UI thread after await:", Thread.CurrentThread.ManagedThreadId == ui_thread)
        except Exception as e:
            print("smoke test failed:", e)
            Environment.ExitCode = 1
        finally:
            window.Close()


def click(button: Button) -> None:
    """What a mouse click does: nothing on a disabled button, else the Click event."""
    if button.IsEnabled:
        button.RaiseEvent(RoutedEventArgs(ButtonBase.ClickEvent))


def exit_if_stuck(seconds: float) -> None:
    time.sleep(seconds)
    print(f"smoke test: no result after {seconds:.0f} s")
    Environment.Exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
