"""
The window: a Window subclass whose content is TodoView.xaml. The XAML holds the layout and the item template; this class
loads it, looks up the named elements and handles their events, which run on the UI thread (the Dispatcher's thread).
"""
from typing import cast
from System import Uri, UriKind
from System.Threading.Tasks import Task
from System.Windows import Application, DependencyObject, FrameworkElement, RoutedEventArgs, RoutedEventHandler, Window, WindowStartupLocation
from System.Windows.Controls import Button, CheckBox, ListBox, TextBlock, TextBox, TextChangedEventArgs
from System.Windows.Controls.Primitives import ToggleButton
from System.Windows.Media import VisualTreeHelper
from todos import Todo, TodoList, example_titles


class TodoWindow(Window):
    def __init__(self) -> None:
        super().__init__()
        self.todos = TodoList()
        self.Title = "Typhon To-Do (WPF)"
        self.Width = 440
        self.Height = 380
        self.MinWidth = 340
        self.MinHeight = 260
        self.WindowStartupLocation = WindowStartupLocation.CenterScreen

        # the BAML the build compiled from TodoView.xaml, a resource of this assembly
        view = cast(FrameworkElement, Application.LoadComponent(Uri("/WpfTodo;component/TodoView.xaml", UriKind.Relative)))
        self.Content = view
        self.input = cast(TextBox, view.FindName("Input"))
        self.add_button = cast(Button, view.FindName("AddButton"))
        self.list = cast(ListBox, view.FindName("List"))
        self.status = cast(TextBlock, view.FindName("Status"))
        self.load_button = cast(Button, view.FindName("LoadButton"))
        self.remove_button = cast(Button, view.FindName("RemoveButton"))
        self.loading = Task.CompletedTask

        self.input.TextChanged += self.on_text_changed
        self.add_button.Click += self.on_add
        self.load_button.Click += self.on_load
        self.remove_button.Click += self.on_remove_done
        # Checked and Unchecked are routed events: they bubble up from each item's CheckBox, so one handler serves them all
        self.list.AddHandler(ToggleButton.CheckedEvent, RoutedEventHandler(self.on_toggled))
        self.list.AddHandler(ToggleButton.UncheckedEvent, RoutedEventHandler(self.on_toggled))
        self.Loaded += lambda sender, e: self.input.Focus()
        self.refresh()

    def on_text_changed(self, sender: object, e: TextChangedEventArgs) -> None:
        self.add_button.IsEnabled = self.input.Text.strip() != ""

    def on_add(self, sender: object, e: RoutedEventArgs) -> None:
        self.todos.add(self.input.Text)
        self.input.Clear()
        self.refresh()

    def on_toggled(self, sender: object, e: RoutedEventArgs) -> None:
        box = cast(CheckBox, e.OriginalSource)
        todo = cast(Todo, box.DataContext)       # the item the template was applied to
        todo.done = box.IsChecked == True
        self.update_status()

    def on_remove_done(self, sender: object, e: RoutedEventArgs) -> None:
        self.todos.remove_done()
        self.refresh()

    def on_load(self, sender: object, e: RoutedEventArgs) -> None:
        # an async method is a .NET Task method: calling it starts it, and it returns at its first await
        self.loading = self.load_examples()

    async def load_examples(self) -> None:
        self.load_button.IsEnabled = False
        self.status.Text = "Loading…"
        # the slow call runs on a thread-pool thread, so the window keeps rendering and reacting meanwhile
        titles = await Task.Run(example_titles)
        # await comes back to the UI thread (the Dispatcher's SynchronizationContext), so elements may be used again
        for title in titles:
            self.todos.add(title)
        self.load_button.IsEnabled = True
        self.refresh()

    def refresh(self) -> None:
        """Shows the model's items again (a plain list does not tell the ListBox when it changes)."""
        self.list.ItemsSource = None
        self.list.ItemsSource = self.todos.items
        self.update_status()

    def update_status(self) -> None:
        self.status.Text = self.todos.summary()
        self.remove_button.IsEnabled = self.todos.any_done()

    def item_box(self, index: int) -> CheckBox:
        """The CheckBox the item template made for item `index` (for the smoke test)."""
        self.list.UpdateLayout()
        box = find_check_box(self.list.ItemContainerGenerator.ContainerFromIndex(index))
        if box is None:
            raise IndexError(f"no CheckBox for item {index}")
        return box

    def shown_items(self) -> list[str]:
        """What the list shows, as `[x] title` lines (for the smoke test)."""
        shown: list[str] = []
        for i in range(self.list.Items.Count):
            box = self.item_box(i)
            mark = "x" if box.IsChecked == True else " "
            shown.append(f"[{mark}] {box.Content}")
        return shown


def find_check_box(element: DependencyObject) -> CheckBox | None:
    """The first CheckBox in the visual tree below `element`."""
    if isinstance(element, CheckBox):
        return cast(CheckBox, element)      # isinstance() narrows Typhon classes only
    for i in range(VisualTreeHelper.GetChildrenCount(element)):
        found = find_check_box(VisualTreeHelper.GetChild(element, i))
        if found is not None:
            return found
    return None
