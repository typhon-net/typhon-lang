<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A WinUI 3 app (Windows App SDK, unpackaged) whose sources are *.ty files. The layout is XAML parsed at run time
    (an embedded resource, not a XAML page), so the WinUI XAML compiler has nothing to do.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(TyphonTargetFramework)-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: an ordinary .exe, no MSIX. The Windows App SDK's bootstrapper finds the installed Windows App Runtime
         (set WindowsAppSDKSelfContained to true on Windows to ship the runtime with the app instead). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The app has no resources of its own, so no resources.pri (makepri.exe, a Windows program, would make an empty one).
         A self-contained app needs it: it holds the Windows App SDK's resources then. -->
    <AppxGeneratePriEnabled Condition="'$(WindowsAppSDKSelfContained)' != 'true'">false</AppxGeneratePriEnabled>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TyphonTypeMode>strict</TyphonTypeMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The to-do model the three desktop samples share. -->
    <TyphonCompile Include="../Shared/todos.ty" />
    <!-- Loaded with XamlReader.Load at run time instead of compiled. -->
    <Page Remove="TodoView.xaml" />
    <EmbeddedResource Include="TodoView.xaml" LogicalName="TodoView.xaml" />
  </ItemGroup>

</Project>
