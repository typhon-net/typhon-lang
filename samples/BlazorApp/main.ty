"""
A Blazor Web App (interactive server rendering) whose components keep their markup in .razor files and their logic in
.ty files: each component inherits a Typhon class (@inherits counter.CounterBase). See README.md.

    dotnet run --project samples/BlazorApp                       (http://localhost:5080)
    dotnet run --project samples/BlazorApp -- --urls http://127.0.0.1:5000
"""
import sys
from Microsoft.AspNetCore.Builder import WebApplication
from Microsoft.Extensions.DependencyInjection import *
from services.todo_store import TodoStore
from services.weather_service import WeatherService

if __name__ == "__main__":
    builder = WebApplication.CreateBuilder(sys.argv[1:])
    builder.Services.AddRazorComponents().AddInteractiveServerComponents()
    # the services the components get injected ([Inject] properties)
    builder.Services.AddSingleton[TodoStore]()
    builder.Services.AddScoped[WeatherService]()

    app = builder.Build()
    app.MapStaticAssets()
    # App is generated by the Razor compiler, which runs next to Typhon's: Typhon cannot see the class, so it is named
    # in a string, like a forward reference in a Python annotation (C# resolves it when it compiles both)
    app.MapRazorComponents["Components.App"]().AddInteractiveServerRenderMode()
    app.Run()
