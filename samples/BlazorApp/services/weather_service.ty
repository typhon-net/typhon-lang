"""A forecast service with an async API, as if it called a remote weather service."""
import asyncio
import random
from dataclasses import dataclass
from datetime import date, timedelta

SUMMARIES = ["Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching"]


@dataclass
class Forecast:
    day: date
    temperature_c: int
    summary: str

    @property
    def temperature_f(self) -> int:
        return 32 + round(self.temperature_c * 9 / 5)

    @property
    def label(self) -> str:
        return self.day.strftime("%a %d %b")


class WeatherService:
    async def forecast(self, days: int) -> list[Forecast]:
        """The next days' forecast; the same numbers for the same day (the generator is seeded with the date)."""
        await asyncio.sleep(0.3)  # the latency of a remote call
        today = date.today()
        result: list[Forecast] = []
        for i in range(1, days + 1):
            day = today + timedelta(days=i)
            rng = random.Random(day.toordinal())
            temperature = rng.randint(-5, 32)
            summary = SUMMARIES[min(len(SUMMARIES) - 1, max(0, (temperature + 5) // 4))]
            result.append(Forecast(day, temperature, summary))
        return result
