"""
A standalone Blazor WebAssembly app whose components keep their markup in .razor files and their logic in .ty files:
each component inherits a Typhon class (@inherits counter.CounterBase). Everything runs in the browser. See README.md.

    dotnet run --project samples/BlazorWasm                      (http://localhost:5090)
    dotnet publish samples/BlazorWasm -c Release                 (static files in bin/Release/net11.0/publish/wwwroot)
"""
from Microsoft.AspNetCore.Components.Web import HeadOutlet
from Microsoft.AspNetCore.Components.WebAssembly.Hosting import WebAssemblyHostBuilder
from Microsoft.Extensions.DependencyInjection import *
from services.todo_store import TodoStore

if __name__ == "__main__":
    builder = WebAssemblyHostBuilder.CreateDefault()
    # App is generated by the Razor compiler, which runs next to Typhon's: Typhon cannot see the class, so it is named
    # in a string, like a forward reference in a Python annotation (C# resolves it when it compiles both).
    # It renders into <div id="app"> of wwwroot/index.html; HeadOutlet renders <PageTitle> into <head>.
    builder.RootComponents.Add["Components.App"]("#app")
    builder.RootComponents.Add[HeadOutlet]("head::after")
    # the service the components get injected ([Inject] properties): one per browser tab
    builder.Services.AddSingleton[TodoStore]()
    # A __main__ block that awaits is an async Main (CPython accepts await only in a coroutine; this file runs on .NET
    # only). RunAsync never completes in a browser; awaiting it sends a startup error to the console.
    await builder.Build().RunAsync()
